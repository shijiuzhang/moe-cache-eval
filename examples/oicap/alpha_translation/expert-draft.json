      "comparator": "gte",
      "threshold": 1,
      "unit": "token/s",
      "population": "successful requests with server usage",
      "min_samples": 4,
      "min_duration_s": 1,
      "quality_eligible": true,
      "authority": "server_usage"
    }
  ],
  "workload_classes": [
    {
      "class_id": "substantive-short-answer",
      "weight_percent": 100,
      "input_tokens": "1-64",
