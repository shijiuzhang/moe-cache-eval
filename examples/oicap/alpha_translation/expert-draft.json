    "container_and_runtime": {"requirement_state": "informational", "constraint": "native local process"},
    "launch_configuration": {"requirement_state": "required", "constraint": "record arguments that affect measurement"},
    "endpoint_boundary": {"requirement_state": "required", "constraint": "loopback OpenAI-compatible endpoint"},
    "external_dependencies": {"requirement_state": "not_required", "constraint": "none"},
    "accelerator_topology": {"requirement_state": "required", "constraint": "CPU protocol qualification only; record processor topology"},
    "host_platform": {"requirement_state": "informational", "constraint": "record OS, CPU, and memory"},
    "parallelism": {"requirement_state": "required", "constraint": "record engine slots"},
    "memory_and_offload": {"requirement_state": "required", "constraint": "record model placement; not adjudicated by alpha.1"},
