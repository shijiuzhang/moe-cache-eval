.DS_Store
.venv/
.cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Authorized procurement material and other private working records must never
# enter this public tree, regardless of the local subdirectory name chosen.
private/

# Large or conditionally redistributable research payloads
data/
artifacts/*.npz
artifacts/*.safetensors
cache-events-*/
routes-*/
models/

# Local build intermediates
paper/**/*.aux
paper/**/*.log

# Third-party material for external case studies; never committed (case study protocol R2).
third_party/

# Canonical traces derived from third-party data stay local; only their hash list is tracked (R2).
case_studies/moe_beyond/canonical/*
!case_studies/moe_beyond/canonical/HASHES.txt
!case_studies/moe_beyond/canonical/CONTENT_HASHES.txt
